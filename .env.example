# ========= LLM 配置（必填其一） =========
# 通义千问（百炼平台 https://bailian.aliyun.com 申请）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
LLM_MODEL=qwen-plus

# 或者 DeepSeek（https://platform.deepseek.com 申请）
# DASHSCOPE_BASE_URL=https://api.deepseek.com/v1
# DASHSCOPE_API_KEY=sk-xxx
# LLM_MODEL=deepseek-chat

# ========= 联网搜索（可选，不配置则网络搜索助手返回提示） =========
# https://app.tavily.com 免费注册，每月 1000 次
TAVILY_API_KEY=

# ========= MCP 市场情报服务（内置 demo，默认开启） =========
# 设为 0 可关闭 MCP 子智能体
ENABLE_MCP=1

# ========= 运行模式 =========
# 1 = 演示模式：不调用 LLM/搜索，按预置轨迹走完整流程（用于无 key 快速体验 / CI）
MOCK_LLM=0

# ========= 路径 =========
SQLITE_DB_PATH=data/demo_market.db
KNOWLEDGE_DOCS_DIR=data/knowledge_docs
